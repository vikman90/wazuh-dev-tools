FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && \
    apt-get install -y lsb-release curl && \
    rm -rf /var/lib/apt/lists/*

ARG WAZUH_DATE=""

# Install Wazuh Manager with dynamic download and fallback
RUN ARCH=$(dpkg --print-architecture) && \
    if [ -z "$WAZUH_DATE" ]; then \
    WAZUH_DATE=$(curl -sI https://packages-dev.wazuh.com/nightly-backup | grep -i '^Date:' | cut -d' ' -f2-6 | xargs -I{} date -u -d "{}" +"%Y-%m-%d"); \
    fi && \
    FOUND=0; \
    for i in $(seq 0 7); do \
    CURRENT_DATE=$(date -d "$WAZUH_DATE - $i days" +%Y-%m-%d); \
    URL="https://packages-dev.wazuh.com/nightly-backup/${CURRENT_DATE}/wazuh-manager_5.0.0-latest_${ARCH}.deb"; \
    if curl -sI --fail "$URL" > /dev/null; then \
    echo "Found package for date ${CURRENT_DATE}"; \
    curl -sSL "$URL" -o /tmp/wazuh-manager.deb; \
    FOUND=1; break; \
    fi; \
    done; \
    if [ "$FOUND" -eq 0 ]; then echo "Could not find Wazuh Manager package in the last 7 days"; exit 1; fi && \
    dpkg -i /tmp/wazuh-manager.deb || apt-get install -f -y && \
    rm /tmp/wazuh-manager.deb

# Expose ports
EXPOSE 1514 1515 1516 55000

# Entrypoint script
COPY manager-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/manager-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/manager-entrypoint.sh"]
