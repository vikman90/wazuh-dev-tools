FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Copy DEB package
COPY wazuh-indexer*.deb /tmp/

# Install Wazuh Indexer with certificate generation
RUN GENERATE_CERTS=true dpkg -i /tmp/wazuh-indexer*.deb || apt-get install -f -y && \
    rm /tmp/wazuh-indexer*.deb && \
    chmod 644 /etc/default/wazuh-indexer

# Expose port
EXPOSE 9200

# Startup script
COPY indexer-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/indexer-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/indexer-entrypoint.sh"]
