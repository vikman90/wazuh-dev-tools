FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*

# Copy DEB package
COPY wazuh-dashboard*.deb /tmp/

# Install Wazuh Dashboard
RUN dpkg -i /tmp/wazuh-dashboard*.deb || \
    (apt-get update && apt-get install -f -y && dpkg -i /tmp/wazuh-dashboard*.deb) && \
    rm /tmp/wazuh-dashboard*.deb

# Create certs directory
RUN mkdir -p /etc/wazuh-dashboard/certs && \
    chmod 500 /etc/wazuh-dashboard/certs

# Expose port
EXPOSE 443

# Entrypoint script
COPY dashboard-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/dashboard-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/dashboard-entrypoint.sh"]
